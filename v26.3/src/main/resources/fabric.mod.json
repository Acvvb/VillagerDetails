{
  "schemaVersion": 1,
  "id": "villagerdetails",
  "version": "${version}",
  "name": "VillagerDetails",
  "description": "This is a mod that fixes the infuriating villager AI behavior that makes players rage.",
  "authors": [
    "Acvvb"
  ],
  "contact": {
    "homepage": "https://github.com/Acvvb/VillagerDetails",
    "sources": "https://github.com/Acvvb/VillagerDetails"
  },
  "license": "MIT",
  "icon": "assets/villagerdetails/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.villagerdetails.VillagerDetails"
    ],
    "client": [
      "com.villagerdetails.client.VillagerDetailsClient"
    ],
    "server": [
      "com.villagerdetails.server.VillagerDetailsServer"
    ]
  },
  "mixins": [
    {
      "config": "villagerdetails.client.mixins.json",
      "environment": "client"
    },
    {
      "config": "villagerdetails.server.mixins.json",
      "environment": "server"
    }
  ],
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "minecraft": "~${minecraft}",
    "java": ">=${javaVersion}",
    "fabric-api": ">=${fabricApiVersion}"
  }
}